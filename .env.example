VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Opcional. URL pública de SFS, usada en el texto de credenciales que se copia
# al crear un usuario. Si se omite, se usa el origen desde el que se abre la app.
VITE_APP_URL=

# Sitekey de Cloudflare Turnstile (widget anti-bots del login). Es pública
# por diseño, pero depende del DOMINIO: cada instancia (cada dominio de
# Vercel) necesita su propio widget registrado en Cloudflare. Sin esto, el
# botón de "Ingresar"/"Crear cuenta" queda deshabilitado — no hay login sin
# esta variable. Para desarrollo local, Cloudflare publica sitekeys de
# prueba que funcionan en cualquier dominio (nunca usar en producción):
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_TURNSTILE_SITE_KEY=
