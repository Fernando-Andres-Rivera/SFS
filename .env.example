VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Opcional. URL pública de SFS, usada en el texto de credenciales que se copia
# al crear un usuario. Si se omite, se usa el origen desde el que se abre la app.
VITE_APP_URL=

# Sitekey de Cloudflare Turnstile (widget anti-bots del login). Es pública
# por diseño, pero depende del DOMINIO: cada instancia (cada dominio de
# Vercel) necesita su propio widget registrado en Cloudflare. Sin esto, el
# botón de "Ingresar"/"Crear cuenta" queda deshabilitado — no hay login sin
# esta variable.
#
# OJO con las sitekeys de prueba de Cloudflare: pasan en cualquier dominio,
# pero su token SOLO valida contra la secret key de prueba que les toca. Si
# Supabase ya tiene la secret key real en Attack Protection, usar una sitekey
# de prueba en local hace que el widget se vea verde y el servidor rechace
# igual, con captcha_failed. Para desarrollo local, agrega `localhost` a los
# hostnames del widget real en Cloudflare y usa su sitekey real aquí.
# Ver DEPLOYMENT.md §3.1.
VITE_TURNSTILE_SITE_KEY=
